---
import Layout from "../../layouts/Layout.astro";
import ComingSoon from "../../components/ComingSoon.astro";
import { localeStorePath, t } from "../../i18n/translations";

const locale = "es" as const;
const strings = t(locale);
---

<Layout locale={locale} canonicalPath="/es/" englishPath="/" spanishPath="/es/">
  <ComingSoon
    locale={locale}
    kicker={strings.home_kicker}
    title={strings.home_title}
    intro={strings.home_intro}
    linkHref={localeStorePath(locale)}
    linkLabel={strings.home_cta_store}
    alternateHref="/"
  />
</Layout>
