---
import Layout from "../../../layouts/Layout.astro";
import ComingSoon from "../../../components/ComingSoon.astro";
import { localeHomePath, t } from "../../../i18n/translations";

const locale = "es" as const;
const strings = t(locale);
---

<Layout
  locale={locale}
  canonicalPath="/es/store/"
  englishPath="/store/"
  spanishPath="/es/store/"
  title={strings.store_meta_title}
  description={strings.store_meta_description}
>
  <ComingSoon
    locale={locale}
    kicker={strings.store_kicker}
    title={strings.store_title}
    intro={strings.store_intro}
    linkHref={localeHomePath(locale)}
    linkLabel={strings.store_back_home}
    alternateHref="/store/"
  />
</Layout>
