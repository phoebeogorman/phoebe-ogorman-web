---
import type { Locale } from "../i18n/translations";
import { t } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

const images = [
  { file: "jacket-0008.webp", w: 1200, h: 1800 },
  { file: "jacket-0026.webp", w: 1200, h: 1800 },
  { file: "jacket-0084.webp", w: 1200, h: 1800 },
  { file: "jacket-0093.webp", w: 1200, h: 1800 },
  { file: "jacket-0114.webp", w: 1200, h: 1800 },
  { file: "jacket-0133.webp", w: 1200, h: 1800 },
  { file: "jacket-0152.webp", w: 1200, h: 1800 },
  { file: "jacket-0187.webp", w: 1200, h: 1800 },
  { file: "jacket-0224.webp", w: 1200, h: 1800 },
  { file: "jacket-0248.webp", w: 1200, h: 1800 },
  { file: "jacket-0312.webp", w: 1200, h: 1800 },
  { file: "jacket-0338.webp", w: 1200, h: 1800 },
  { file: "jacket-0400.webp", w: 1200, h: 1800 },
  { file: "jacket-0466.webp", w: 1200, h: 1800 },
  { file: "jacket-0521.webp", w: 1200, h: 1800 },
];
---

<section class="gallery-section" aria-labelledby="gallery-heading">
  <header class="gallery-header po-container">
    <div class="gallery-header-title">
      <p class="kicker">{strings.bio_kicker}</p>
      <h2 id="gallery-heading" class="gallery-title">{strings.bio_heading}</h2>
    </div>
    <p class="copy gallery-bio">{strings.bio_body}</p>
  </header>

  <ul class="gallery-grid" role="list">
    {
      images.map((img, i) => (
        <li class="gallery-item">
          <img
            src={`/images/${img.file}`}
            alt={`${strings.gallery_image_alt_prefix} ${i + 1}`}
            width={img.w}
            height={img.h}
            loading={i < 6 ? "eager" : "lazy"}
            decoding="async"
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .gallery-section {
    border-top: 1px solid var(--border);
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }

  .gallery-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 768px) {
    .gallery-header {
      grid-template-columns: 1fr 1fr;
      align-items: end;
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .gallery-header-title {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .gallery-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.05em;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .gallery-bio {
    max-width: 48ch;
  }

  .gallery-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.5rem, 1.5vw, 1rem);
    padding-inline: var(--container-pad);
  }

  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery-item {
    overflow: hidden;
    background: var(--border);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 2 / 3;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .gallery-item:hover img {
    transform: scale(1.03);
  }
</style>
