---
/**
 * The full page body, shared by home and store.
 *
 * Both routes are placeholders and differ only in their wording and in the
 * single link they offer, so they are one component rather than two nearly
 * identical ones.
 */
import type { Locale } from "../i18n/translations";
import { alternateLocale, contact, t } from "../i18n/translations";

interface Props {
  locale: Locale;
  kicker: string;
  title: string;
  intro: string;
  /** The one link offered besides the email, e.g. the store or the way back. */
  linkHref: string;
  linkLabel: string;
  /** Where the language switcher points, same page in the other locale. */
  alternateHref: string;
}

const {
  locale,
  kicker,
  title,
  intro,
  linkHref,
  linkLabel,
  alternateHref,
} = Astro.props;

const strings = t(locale);
const altLocale = alternateLocale(locale);
const year = new Date().getFullYear();

// The chosen language travels in the URL so that the locale script in the
// document head persists it, rather than immediately redirecting back.
const switcherHref = `${alternateHref}?lang=${altLocale}`;
---

<div class="shell">
  <header class="shell-header po-container">
    <img
      src="/images/logo-phoebe-ogorman.webp"
      srcset="/images/logo-phoebe-ogorman.webp 1x, /images/logo-phoebe-ogorman@2x.webp 2x"
      alt={strings.logo_alt}
      width="180"
      height="78"
      class="shell-logo"
    />

    <a href={switcherHref} class="shell-lang" aria-label={strings.language_switch_label}>
      {strings.language_switch_text}
    </a>
  </header>

  <main id="main-content" class="shell-main po-container" aria-labelledby="page-title">
    <p class="kicker">{kicker}</p>
    <h1 id="page-title" class="display-title shell-title">{title}</h1>
    <p class="copy shell-intro">{intro}</p>

    <div class="shell-actions">
      <a href={`mailto:${contact.email}`} class="shell-link">{strings.coming_soon_note}</a>
      <span class="shell-divider" aria-hidden="true">/</span>
      <a href={linkHref} class="shell-link">{linkLabel}</a>
    </div>
  </main>

  <footer class="shell-footer po-container">
    <p class="shell-muted">&copy; {year} Phoebe O'Gorman. {strings.footer_rights}</p>
    <a
      href={contact.instagram}
      class="shell-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      {contact.instagramHandle}
    </a>
  </footer>
</div>

<style>
  /* The page is short by design, so the shell fills the viewport and pins the
     footer to the bottom instead of leaving it floating mid-screen. */
  .shell {
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .shell-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .shell-logo {
    width: auto;
    height: clamp(48px, 7vw, 78px);
    object-fit: contain;
  }

  .shell-lang {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .shell-lang:hover {
    color: var(--text-primary);
    border-color: var(--text-primary);
  }

  .shell-main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 1.25rem;
    padding-block: clamp(3rem, 10vw, 7rem);
  }

  .shell-title {
    max-width: 12ch;
  }

  .shell-intro {
    max-width: 46ch;
  }

  .shell-actions {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-top: 0.75rem;
  }

  .shell-link {
    font-size: 0.9375rem;
    font-weight: 500;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--text-primary);
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .shell-link:hover {
    opacity: 0.55;
  }

  .shell-divider {
    color: var(--text-secondary);
  }

  .shell-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--border);
  }

  .shell-muted {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  @media (max-width: 560px) {
    .shell-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
