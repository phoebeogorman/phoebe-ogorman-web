---
import NewsletterForm from "./NewsletterForm.astro";
import type { Locale } from "../i18n/translations";
import { contact, t } from "../i18n/translations";

interface Props {
  locale: Locale;
  alternateHref: string;
}

const { locale, alternateHref } = Astro.props;
const strings = t(locale);
const year = new Date().getFullYear();

import { alternateLocale } from "../i18n/translations";
const altLocale = alternateLocale(locale);
const switcherHref = `${alternateHref}?lang=${altLocale}`;
---

<div class="page">
  {/* Header and hero are grouped in one 100svh block so the hero always
      fills exactly the first viewport, whatever the header's rendered
      height turns out to be: flexbox distributes the space, no fixed or
      calc()-derived header height to keep in sync. */}
  <div class="viewport-hero">
    <header class="site-header po-container">
      <img
        src="/images/logo-phoebe-ogorman.webp"
        srcset="/images/logo-phoebe-ogorman.webp 1x, /images/logo-phoebe-ogorman@2x.webp 2x"
        alt={strings.logo_alt}
        width="180"
        height="78"
        class="site-logo"
      />
      <a href={switcherHref} class="lang-switch" aria-label={strings.language_switch_label}>
        {strings.language_switch_text}
      </a>
    </header>

    <section class="hero po-container" aria-labelledby="hero-heading">
      <p class="kicker">{strings.home_kicker}</p>
      <h1 id="hero-heading" class="display-title hero-title">{strings.home_title}</h1>
      <p class="hero-subtitle">{strings.home_subtitle}</p>
      <p class="copy hero-intro">{strings.home_intro}</p>
      <p class="copy hero-intro">{strings.home_intro_secondary}</p>
      <NewsletterForm locale={locale} />
    </section>
  </div>

  <main id="main-content" aria-labelledby="hero-heading">
    <slot />

    <section class="retailers po-container" aria-labelledby="retailers-heading">
      <h2 id="retailers-heading" class="retailers-heading">{strings.retailers_heading}</h2>
      <p class="copy">{strings.retailers_body}</p>
      <a href={`mailto:${contact.wholesaleEmail}?subject=Wholesale`} class="footer-link retailers-cta">
        {strings.retailers_cta}
      </a>
    </section>
  </main>

  <footer class="site-footer po-container">
    <p class="footer-muted">&copy; {year} Phoebe O'Gorman. {strings.footer_rights}</p>
    <a
      href={contact.instagram}
      class="footer-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      {contact.instagramHandle}
    </a>
  </footer>
</div>

<style>
  .page {
    display: flex;
    flex-direction: column;
  }

  /* Fills exactly the first viewport: header takes its natural height and
     the hero (flex: 1 below) claims the rest, so there is no calc() to keep
     in sync with the header's own padding and logo clamps. */
  .viewport-hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .site-logo {
    width: auto;
    height: clamp(48px, 7vw, 78px);
    object-fit: contain;
  }

  .lang-switch {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .lang-switch:hover {
    color: var(--text-primary);
    border-color: var(--text-primary);
  }

  .hero {
    flex: 1;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
  }

  .hero-title {
    max-width: 14ch;
  }

  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 500;
    line-height: 1.2em;
    color: var(--text-primary);
  }

  .hero-intro {
    max-width: 46ch;
  }

  .hero-cta {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--text-primary);
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .hero-cta:hover {
    opacity: 0.55;
  }

  .retailers {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding-block: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--border);
  }

  .retailers-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.05em;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .footer-muted {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .footer-link {
    font-size: 0.9375rem;
    font-weight: 500;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--text-primary);
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .footer-link:hover {
    opacity: 0.55;
  }

  @media (max-width: 560px) {
    .site-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
